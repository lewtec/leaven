{
  "cases": [
    {
      "name": "package-p",
      "package": "p",
      "contains": [
        "package p",
        "\"github.com/lewtec/leaven/libc\"",
        "func logf(fmt unsafe.Pointer, varargs ...interface{})",
        "func file_bits(path unsafe.Pointer)",
        "libc.Vsnprintf",
        "libc.Snprintf",
        "libc.Fdopen",
        "libc.Fclose",
        "libc.Ptr(&varargs)"
      ],
      "not_contains": [
        "llvm_va_start",
        "llvm_va_end",
        " = vsnprintf(",
        " = snprintf(",
        " = fdopen(",
        " = fclose("
      ]
    }
  ]
}
