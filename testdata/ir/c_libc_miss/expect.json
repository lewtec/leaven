{
  "cases": [
    {
      "name": "package-p",
      "package": "p",
      "contains": [
        "package p",
        "\"os\"",
        "\"github.com/lewtec/leaven/libc\"",
        "os.Stderr",
        "libc.As[os.File]",
        "libc.Fprintf",
        "libc.Abort",
        "libc.Realloc",
        "func die(msg unsafe.Pointer)",
        "func grow(p unsafe.Pointer, n int64) unsafe.Pointer",
        "func release(p unsafe.Pointer)"
      ],
      "not_contains": [
        "type _IO_FILE",
        "fprintf(",
        "call = realloc",
        "abort()"
      ]
    }
  ]
}
